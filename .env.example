# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Optional (Vercel): Point the Vercel frontend to an external Node/WebSocket sync backend
# (e.g. Render, Railway, Fly.io, or Cloud Run running server.ts). Leave blank to use
# same-origin /api routes (works out of the box locally and with Vercel Serverless Functions).
VITE_SYNC_SERVER_URL=""

# Optional (Vercel Serverless Multi-Device Sync): Connect Upstash Redis or Vercel KV
# in your Vercel project Storage settings so serverless API instances share live sessions.
KV_REST_API_URL=""
KV_REST_API_TOKEN=""
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
